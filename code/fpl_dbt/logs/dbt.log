    create or replace table `fpl-analytics-488811`.`curated_player_data`.`five_week_rolling_stats`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS(
  SELECT * FROM `fpl-analytics-488811`.`stg_player_data`.`stg_player_stats`
),

five_gw_rolling_stats AS (
  SELECT
    player_id,
    gameweek,
    

    
        SUM(goals_scored) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_goals,
    

    
        SUM(assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_assists,
    

    
        ROUND(AVG(expected_goals) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 4 FOLLOWING
        ), 3)
    

 AS five_gw_xg_avg,
    

    
        ROUND(AVG(expected_assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 4 FOLLOWING
        ), 3)
    

 AS five_gw_xa_avg,
    

    
        SUM(minutes) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_minutes

  FROM player_data
  WHERE
    minutes > 0
)

SELECT * FROM five_gw_rolling_stats
    );
  
[0m18:43:49.924285 [debug] [Thread-4 (]: On model.fpl_analytics.player_taxonomies: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "fpl_analytics", "target_name": "dev", "node_id": "model.fpl_analytics.player_taxonomies"} */

  
    

    create or replace table `fpl-analytics-488811`.`curated_player_data`.`player_taxonomies`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS (
    SELECT * FROM `fpl-analytics-488811`.`raw_player_data`.`full_player_data`
),

team_data AS (
    SELECT * FROM `fpl-analytics-488811`.`curated_team_data`.`team_taxonomies`
),


player_taxonomies AS (
  SELECT
    p.id AS player_id,
    CASE
      WHEN LENGTH(p.known_name) > 0 THEN p.known_name
      ELSE CONCAT(p.first_name, ' ', p.second_name)
      END AS player_name,
    t.team_name AS team_name,
    CASE
      WHEN p.element_type = 1 THEN 'GK'
      WHEN p.element_type = 2 THEN 'DEF'
      WHEN p.element_type = 3 THEN 'MID'
      WHEN p.element_type = 4 THEN 'FWD'
      ELSE 'Unknown'
    END AS position,
    p.code AS pl_id,
    CONCAT('https://resources.premierleague.com/premierleague/photos/players/110x140/p', p.code, '.png') AS image_url
  FROM 
    player_data p
  LEFT JOIN 
    team_data t
    ON p.team = t.team_id
)

SELECT * FROM player_taxonomies
    );
  
