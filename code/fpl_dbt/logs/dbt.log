    create or replace table `fpl-analytics-488811`.`curated_player_data`.`five_week_rolling_stats`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS(
  SELECT * FROM `fpl-analytics-488811`.`stg_player_data`.`stg_player_stats`
),

five_gw_rolling_stats AS (
  SELECT
    player_id,
    gameweek,
    

    
        SUM(goals_scored) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_goals,
    

    
        SUM(assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_assists,
    

    
        SUM(expected_goals) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_xg_avg,
    

    
        SUM(expected_assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_xa_avg,
    

    
        SUM(minutes) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_minutes

  FROM player_data
  WHERE
    minutes > 0
)

SELECT * FROM five_gw_rolling_stats
    );
  
