),

individual_players AS (
    SELECT
        pd.player_name AS player,
        pd.player_image,
        ps.*,
        t.team_logo
    FROM player_data pd
    LEFT JOIN team_info t 
        ON pd.team_name = t.team_name
    LEFT JOIN player_stats ps 
        ON pd.player_id = ps.player_id                    
)

SELECT * FROM individual_players
    );
  
