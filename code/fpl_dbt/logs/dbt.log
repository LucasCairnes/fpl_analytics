WITH player_data AS (
    SELECT * FROM `fpl-analytics-488811`.`raw_player_data`.`full_player_data`
),

stg_player_data AS (
    id AS player_id,
    code AS pl_id,
    element_type,
    first_name,
    form,
    news,
    now_cost,
    points_per_game,
    second_name,
    status,
    team AS team_id,
    total_points,
    value_form,
    web_name,
    known_name,
    minutes,
    goals_scored,
    assists,
    clean_sheets,
    goals_conceded,
    own_goals,
    penalties_saved,
    penalties_missed,
    yellow_cards,
    red_cards,
    saves,
    bonus,
    bps,
    influence,
    creativity,
    threat,
    ict_index,
    clearances_blocks_interceptions,
    recoveries,
    tackles,
    defensive_contribution,
    starts,
