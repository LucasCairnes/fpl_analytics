    create or replace table `fpl-analytics-488811`.`curated_player`.`cur_player_taxonomies`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS (
    SELECT * FROM `fpl-analytics-488811`.`stg_player`.`stg_player_data`
),

team_data AS (
    SELECT * FROM `fpl-analytics-488811`.`curated_team`.`cur_team_taxonomies`
),

cur_player_taxonomies AS (
  SELECT
    p.player_id,
    CASE
      WHEN LENGTH(p.known_name) > 0 THEN p.known_name
      ELSE CONCAT(p.first_name, ' ', p.second_name)
      END AS player_name,
    t.team_name,
    CASE
      WHEN p.element_type = 1 THEN 'GK'
      WHEN p.element_type = 2 THEN 'DEF'
      WHEN p.element_type = 3 THEN 'MID'
      WHEN p.element_type = 4 THEN 'FWD'
      ELSE 'Unknown'
    END AS position,
    p.pl_id,
    CONCAT('https://resources.premierleague.com/premierleague25/photos/players/110x140/', p.pl_id, '.png') AS player_image
  FROM 
    player_data p
  LEFT JOIN 
    team_data t
    ON p.team_id = t.team_id
)

SELECT * FROM cur_player_taxonomies
    );
  
[0m12:13:55.765633 [debug] [Thread-1 (]: On model.fpl_analytics.cur_player_five_gw_stats: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "fpl_analytics", "target_name": "dev", "node_id": "model.fpl_analytics.cur_player_five_gw_stats"} */

  
    

    create or replace table `fpl-analytics-488811`.`curated_player`.`cur_player_five_gw_stats`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS(
  SELECT * FROM `fpl-analytics-488811`.`curated_player`.`cur_total_stats`
),

rolling_stats AS (
  SELECT
    player_id,
    gameweek,
    

    
        SUM(goals_scored) OVER(
            PARTITION BY player_id
            ORDER BY gameweek 
            RANGE BETWEEN 4 PRECEDING AND CURRENT ROW
        )
    

 AS five_gw_goals,
    

    
        SUM(assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek 
            RANGE BETWEEN 4 PRECEDING AND CURRENT ROW
        )
    

 AS five_gw_assists,
    

    
        SUM(expected_goals) OVER(
            PARTITION BY player_id
            ORDER BY gameweek 
            RANGE BETWEEN 4 PRECEDING AND CURRENT ROW
        )
    

 AS five_gw_xg,
    

    
        SUM(expected_assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek 
            RANGE BETWEEN 4 PRECEDING AND CURRENT ROW
        )
    

 AS five_gw_xa,
    

    
        SUM(minutes) OVER(
            PARTITION BY player_id
            ORDER BY gameweek 
            RANGE BETWEEN 4 PRECEDING AND CURRENT ROW
        )
    

 AS five_gw_minutes
  FROM player_data
),

cur_player_five_gw_stats AS (
  SELECT
    r.*,
    r.five_gw_goals - five_gw_xg AS xg_performance,
    r.five_gw_assists - five_gw_xa AS xa_performance,
    r.five_gw_goals + r.five_gw_assists - r.five_gw_xg - r.five_gw_xa AS xga_performance
  FROM rolling_stats r
  WHERE
    five_gw_minutes > 270
)

SELECT * FROM cur_player_five_gw_stats
    );
  
[0m12:13:55.765812 [debug] [Thread-3 (]: On model.fpl_analytics.cur_player_ten_gw_stats: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "fpl_analytics", "target_name": "dev", "node_id": "model.fpl_analytics.cur_player_ten_gw_stats"} */

  
    

    create or replace table `fpl-analytics-488811`.`curated_player`.`cur_player_ten_gw_stats`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS(
  SELECT * FROM `fpl-analytics-488811`.`curated_player`.`cur_total_stats`
),

rolling_stats AS (
  SELECT
    player_id,
    gameweek,
    

    
        SUM(minutes) OVER(
            PARTITION BY player_id
            ORDER BY gameweek 
            RANGE BETWEEN 9 PRECEDING AND CURRENT ROW
        )
    

 AS ten_gw_minutes,
    

    
        ROUND(AVG(total_points) OVER(
            PARTITION BY player_id
            ORDER BY gameweek 
            RANGE BETWEEN 9 PRECEDING AND CURRENT ROW
        ), 3)
    

 AS ten_gw_avg_pts
  FROM player_data
),

cur_player_ten_gw_stats AS (
  SELECT
    r.*
  FROM rolling_stats r
  WHERE
    ten_gw_minutes > 540
)

SELECT * FROM cur_player_ten_gw_stats
    );
  
