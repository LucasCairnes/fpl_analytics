    create or replace table `fpl-analytics-488811`.`fpl_prod`.`overview_stats`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS (
    SELECT * FROM `fpl-analytics-488811`.`curated_player`.`cur_player_taxonomies`
),

player_stats AS (
    SELECT * FROM `fpl-analytics-488811`.`curated_player`.`cur_total_stats` 
),

overview_stats AS (
    SELECT
        d.player_name,
        d.player_image,
        d.position,
        s.goals_scored,
        s.assists
    FROM player_data d
    LEFT JOIN player_stats s
        ON d.player_id = s.player_id
)

SELECT * FROM overview_stats
    );
  
