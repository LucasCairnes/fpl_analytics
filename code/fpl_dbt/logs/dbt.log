[0m15:46:45.867183 [debug] [Thread-1 (]: On model.fpl_analytics.five_week_rolling_stats: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "fpl_analytics", "target_name": "dev", "node_id": "model.fpl_analytics.five_week_rolling_stats"} */

  
    

    create or replace table `fpl-analytics-488811`.`curated_player_data`.`five_week_rolling_stats`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS(
  SELECT * FROM `fpl-analytics-488811`.`stg_player_data`.`stg_player_stats`
),

rolling_stats AS (
  SELECT
    player_id,
    gameweek,
    

    
        SUM(goals_scored) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_goals,
    

    
        SUM(assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_assists,
    

    
        SUM(expected_goals) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_xg,
    

    
        SUM(expected_assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_xa,
    

    
        SUM(minutes) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_minutes
  FROM player_data
),

five_gw_rolling_stats AS (
  SELECT
    r.*,
    r.five_gw_goals - five_gw_xg AS xg_performance,
    r.five_gw_assists - five_gw_xa AS xa_performance,
    r.five_gw_goals + r.five_gw_assists - r.five_gw_xg - r.five_gw_xa AS xga_performance
  FROM rolling_stats r
  WHERE
    five_gw_minutes > 270
)

SELECT * FROM five_gw_rolling_stats
    );
  
