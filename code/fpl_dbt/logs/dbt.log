    OPTIONS()
    as (
      

WITH fixture_data AS (
    SELECT * FROM `fpl-analytics-488811`.`raw_fixture_data`.`full_fixture_data`
),

stg_fixtures AS (
    SELECT
        id AS fixture_id,
        CAST(event AS int) AS gameweek,
