[0m16:14:21.377302 [debug] [Thread-1 (]: On model.fpl_analytics.fixture_matrix: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "fpl_analytics", "target_name": "dev", "node_id": "model.fpl_analytics.fixture_matrix"} */

  
    

    create or replace table `fpl-analytics-488811`.`fpl_prod`.`fixture_matrix`
      
    
    

    
    OPTIONS()
    as (
      

WITH fixture_data AS (
    SELECT * FROM `fpl-analytics-488811`.`curated_fixture`.`cur_next_five_fixtures`
),

team_info AS (
    SELECT * FROM `fpl-analytics-488811`.`curated_team`.`cur_team_taxonomies` 
),

fixture_matrix AS (
    SELECT
        t.team_logo,
        t.team_name,
        COALESCE(t1.short_name, '') AS opp1,
        COALESCE(t2.short_name, '') AS opp2,
        COALESCE(t3.short_name, '') AS opp3,
        COALESCE(t4.short_name, '') AS opp4,
        COALESCE(t5.short_name, '') AS opp5,
        f.mean_difficulty_next_5
    FROM fixture_data f
    LEFT JOIN team_info t
        ON f.team_id = t.team_id
    LEFT JOIN team_info t1
        ON f.opp_1 = t1.team_id
    LEFT JOIN team_info t2
        ON f.opp_2 = t2.team_id
    LEFT JOIN team_info t3
        ON f.opp_3 = t3.team_id
    LEFT JOIN team_info t4
        ON f.opp_4 = t4.team_id
    LEFT JOIN team_info t5
        ON f.opp_5 = t5.team_id
)

SELECT * FROM fixture_matrix
    );
  
