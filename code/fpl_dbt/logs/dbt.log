        AVG(CASE WHEN match_order <= 5 THEN CAST(match_difficulty AS FLOAT64) END) AS mean_difficulty_next_5
    FROM ordered_fixtures
    WHERE match_order <= 5
    GROUP BY team_id
)

SELECT * FROM upcoming_fixtures
    );
  
