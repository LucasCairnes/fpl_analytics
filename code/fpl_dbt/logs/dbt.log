[0m15:51:37.671702 [debug] [Thread-1 (]: On model.fpl_analytics.five_week_rolling_stats: /* {"app": "dbt", "dbt_version": "1.11.6", "profile_name": "fpl_analytics", "target_name": "dev", "node_id": "model.fpl_analytics.five_week_rolling_stats"} */

  
    

    create or replace table `fpl-analytics-488811`.`curated_player_data`.`five_week_rolling_stats`
      
    
    

    
    OPTIONS()
    as (
      

WITH player_data AS(
  SELECT * FROM `fpl-analytics-488811`.`stg_player_data`.`stg_player_stats`
),

five_gw_rolling_stats AS (
  SELECT
    player_id,
    gameweek,
    

    
        SUM(goals_scored) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_goals,
    

    
        SUM(assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 5 FOLLOWING
        )
    

 AS five_gw_assists,
    

    
        ROUND(AVG(expected_goals) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 4 FOLLOWING
        ), 3)
    

 AS five_gw_xg_avg,
    

    
        ROUND(AVG(expected_assists) OVER(
            PARTITION BY player_id
            ORDER BY gameweek DESC
            ROWS BETWEEN CURRENT ROW AND 4 FOLLOWING
        ), 3)
    

 AS five_gw_xa_avg
  FROM player_data
  WHERE
    minutes > 0
)

SELECT * FROM five_gw_rolling_stats
    );
  
